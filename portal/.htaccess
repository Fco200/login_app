# FV DIGITAL - Portal de clientes
# URLs amigables para que los clientes accedan sin rutas complicadas.
# Ejemplos:
#   /login_app/portal/            -> Panel (índice)
#   /login_app/portal/mis-solicitudes
#   /login_app/portal/chat
#   /login_app/portal/juegos
Options -MultiViews
RewriteEngine On

RewriteRule ^panel/?$                 index.php         [L,QSA]
RewriteRule ^inicio/?$                index.php         [L,QSA]
RewriteRule ^mis-solicitudes/?$       solicitudes.php   [L,QSA]
RewriteRule ^nueva-solicitud/?$       solicitud.php         [L,QSA]
RewriteRule ^nueva-solicitud-empresa/?$ solicitud-empresa.php [L,QSA]
RewriteRule ^chat/?$                  mensajes.php      [L,QSA]
RewriteRule ^juegos/?$                juego.php         [L,QSA]
RewriteRule ^notificaciones/?$        notificaciones.php [L,QSA]
RewriteRule ^soporte/?$               soporte.php       [L,QSA]
RewriteRule ^mi-perfil/?$             perfil.php        [L,QSA]
RewriteRule ^salir/?$                 cerrar.php        [L,QSA]

# Cualquier ruta que apunte a un archivo o carpeta real se sirve tal cual
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]